# Copie para .env e preencha os valores:
#   cp .env.example .env

# Long-Lived Access Token do Home Assistant (Perfil → Segurança)
HA_TOKEN=substitua_pelo_token

# Entity ID da tomada Tuya (Developer Tools → States), ex: switch.tomada_escritorio
ENTITY_ID=switch.sua_tomada

# Temperaturas de verificação (°C)
# TEMP_ON  = liga a tomada se a temperatura for maior ou igual a este valor
# TEMP_OFF = desliga a tomada se a temperatura for menor ou igual a este valor
TEMP_ON=28
TEMP_OFF=25

# Intervalo entre verificações (segundos). 900 = 15 min
POLL_SECONDS=900

# Janela horária local (America/Sao_Paulo): [WINDOW_START, WINDOW_END)
WINDOW_START=10
WINDOW_END=17

# Santa Cruz do Sul - RS (Open-Meteo, sem chave)
LAT=-29.7175
LON=-52.4258
TZ=America/Sao_Paulo

# Logs detalhados (volume ./logs no host)
LOG_DIR=/logs
LOG_RETENTION_DAYS=7
